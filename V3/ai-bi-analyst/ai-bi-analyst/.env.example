# ---------------------------------------------------------------------------
# Copy to .env and edit. Nothing here is ever sent to the browser.
# The app runs fully offline with LLM_PROVIDER=heuristic and no API key.
# ---------------------------------------------------------------------------

# heuristic | openai | anthropic
LLM_PROVIDER=heuristic

# Only needed for the matching provider. Keys stay server-side.
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=90

# Governed opt-in: send a small masked row sample to the model. Off by default.
ALLOW_MASKED_SAMPLE_TO_LLM=false

# Storage. Both are created on first run.
WORKSPACE_DIR=./.workspace
METADATA_DB=./.workspace/metadata.sqlite

# Limits
MAX_UPLOAD_MB=200
PROFILE_ROW_LIMIT=500000
PREVIEW_ROW_LIMIT=50
QUERY_ROW_LIMIT=5000
QUERY_TIMEOUT_SECONDS=30
SESSION_RETENTION_HOURS=24

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
